{
  "name": "@solar-republic/crypto",
  "version": "0.6.1",
  "description": "Core crypto library for StarShell",
  "homepage": "https://starshell.net/",
  "repository": "github:SolarRepublic/crypto",
  "license": "MIT",
  "author": {
    "name": "Blake Regalia",
    "email": "blake.regalia@gmail.com",
    "url": "https://blake-regalia.com/"
  },
  "type": "module",
  "main": "dist/main.js",
  "module": "dist/main.js",
  "types": "dist/main.d.ts",
  "files": [
    "dist/"
  ],
  "exports": {
    ".": "./dist/main.js",
    "./argon2": "./dist/wasm/argon2.js",
    "./bcrypt": "./dist/wasm/bcrypt.js",
    "./hmac": "./dist/wasm/hmac.js",
    "./ripemd160": "./dist/wasm/ripemd160.js",
    "./sha256": "./dist/wasm/sha256.js",
    "./wasm/*": "./dist/wasm/*"
  },
  "scripts": {
    "clean": "rm -rf dist/*",
    "build-bip39-wordlist-english": "node ./gen/bip39-wordlist-english.mjs > ./src/bip39-wordlist-english.ts",
    "build-wasm-hash": "mkdir -p ./src/wasm/bytecode && node ./gen/wasm-hash.mjs ${hash} > ./src/wasm/bytecode/${hash}.wasm.gz.ts",
    "build-wasm-hash:ripemd160": "hash=ripemd160 pnpm run build-wasm-hash",
    "build-wasm-hash:sha256": "hash=sha256 pnpm run build-wasm-hash",
    "build-wasm-hash:sha3": "hash=sha3 pnpm run build-wasm-hash",
    "build-wasm-hash:all": "pnpm run build-wasm-hash:ripemd160 && pnpm run build-wasm-hash:sha256 && pnpm run build-wasm-hash:sha3",
    "build:tsc": "tsc -p tsconfig.mjs.json && tsc-esm-fix --target='dist'",
    "build": "pnpm run build-bip39-wordlist-english && pnpm run build-wasm-hash:all && pnpm run build:tsc",
    "test:all": "pnpm run test test/**.ts",
    "debug": "node --inspect-brk --loader ts-node/esm"
  },
  "devDependencies": {
    "@blake.regalia/eslint-config-elite": "^0.5.22",
    "@blake.regalia/tsconfig": "^0.3.7",
    "@rollup/plugin-typescript": "^12.1.4",
    "@solar-republic/types": "^0.3.13",
    "@tsconfig/node22": "^22.0.2",
    "@types/chai": "^5.2.2",
    "@types/node": "^24.2.0",
    "@types/web": "^0.0.259",
    "@typescript-eslint/parser": "^8.39.0",
    "bun-types": "^1.2.19",
    "chai": "^5.2.1",
    "chai-bites": "^0.2.0",
    "esformatter": "^0.11.3",
    "eslint": "^9.32.0",
    "rollup": "^4.46.2",
    "ts-node": "^10.9.2",
    "ts-toolbelt": "^9.6.0",
    "tsc-esm-fix": "^3.1.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@blake.regalia/belt": "^0.57.8",
    "@solar-republic/wasm-secp256k1": "0.6.3",
    "hash-wasm": "^4.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.14.0"
}
